# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
*.egg-info/

# SUMO generated files (created automatically at runtime)
backend/networks/*.net.xml
backend/networks/*.osm
backend/networks/*.log
backend/networks/*.rou.xml
backend/networks/*.sumocfg
backend/networks/_smoke/
backend/tmp_building_test/
data/processed/demo/*.dump

# Logs
*.log

# Claude Code IDE
.claude/

# Environment & credentials (never commit)
.env
.env.local
gcp_key.json
*_service_account.json

# RL graph cache & logs (runtime-generated, not needed in repo)
backend/data/v4_graph_cache/
logs/

# 전국 OSM 원본과 시도별 조각 — 합쳐서 500MB 가까이 되는 바이너리라 저장소에 넣지 않는다.
# 원본은 각자 내려받고(작업폴더에 두면 코드가 알아서 찾는다), 조각은 아래 명령으로 만든다:
#   backend/.venv/Scripts/python.exe backend/scripts/build_osm_slices.py
*.osm.pbf
backend/data/osm_slices/

# Managed GIS data
data/raw/*
data/processed/*
!data/raw/**/.gitkeep
!data/processed/**/.gitkeep
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.gpkg
*.parquet
*.sqlite
*.zip

# OS
.DS_Store
Thumbs.db
desktop.ini

# Design drafts
design.html
design_extracted/
backend/networks/_demand/
backend/networks/_aseg/

# netconvert 타입 파일 — 실행 시 SUMO 원본에서 자동 생성 (main.py _osm_typemap)
backend/networks/*.typ.xml
