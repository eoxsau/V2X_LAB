# Logs
*.log

# Claude Code IDE
.claude/

# Environment & credentials (never commit)
.env
.env.local
gcp_key.json
*_service_account.json

# RL model weights & graph cache (large binaries — use Git LFS or external storage)
backend/app/services/rl/models/*.pt
backend/app/services/rl/models/v4/
backend/data/v4_graph_cache/
logs/

